version: '3.9'

services:
  mcp-app:
    build: .
    ports:
      - "8080:8080"
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/mcp_db
      SPRING_DATASOURCE_USERNAME: mcp_user
      SPRING_DATASOURCE_PASSWORD: changeme
      SPRING_DATA_REDIS_HOST: redis
      SPRING_DATA_REDIS_PASSWORD: changeme
      KEYCLOAK_URL: http://keycloak:8080
      OPENAI_API_KEY: ${OPENAI_API_KEY}
    depends_on:
      - postgres
      - redis
      - keycloak
    networks:
      - mcp-network

networks:
  mcp-network:
    driver: bridge
