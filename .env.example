# ==============================================================================
# Incident Warden — Enterprise Configuration & Secrets Template
# Copy this file to .env and provide your production environment values.
# ==============================================================================

# ─── Core Security & Secrets (Mandatory) ─────────────────────────────────────
# Database password. Required: application.yml carries no default for it outside the local
# profile, so the application refuses to start without this set.
DB_PASSWORD=

# Cryptographic signing key for JWT tokens. MUST be at least 32 characters (256 bits).
MCP_JWT_SECRET=change-this-to-a-secure-random-32-character-secret-in-production

# There is no admin-password variable. The seeded admin starts on its own username as a
# single-use password and cannot do anything until that is replaced at first sign-in. To recover a
# lost one: UPDATE auth.users SET password_hash = NULL WHERE username = 'admin'; then restart.

# ─── Database Configuration (PostgreSQL + pgvector) ──────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=incident_warden_db
POSTGRES_USER=warden_user
POSTGRES_PASSWORD=change-this-local-password
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-password

# ─── Redis Configuration (Distributed Locks, Rate Limiting & Denylist) ────────
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
REDIS_PASSWORD=
VAULT_DEV_ROOT_TOKEN_ID=change-this-vault-token

# ─── LLM AI Provider Configuration ───────────────────────────────────────────
# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=phi3:mini
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud LLM Providers (Optional - uncomment to enable)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json

# ─── ITSM Integrations & Connector Credentials ───────────────────────────────
# ServiceNow
MCP_SERVICENOW_ENABLED=false
SERVICENOW_INSTANCE_URL=https://dev-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=

# Freshservice
MCP_FRESHSERVICE_ENABLED=false
FRESHSERVICE_DOMAIN=https://company.freshservice.com
FRESHSERVICE_API_KEY=

# Jira Service Management
MCP_JIRA_ENABLED=false
JIRA_INSTANCE_URL=https://company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# ─── Integration HTTP Timeouts (always enforced) ─────────────────────────────
MCP_INTEGRATIONS_HTTP_CONNECT_TIMEOUT_MS=5000
MCP_INTEGRATIONS_HTTP_READ_TIMEOUT_MS=10000

# ─── Rate Limiting & Security ────────────────────────────────────────────────
MCP_RATE_LIMIT_LOGIN=10
MCP_RATE_LIMIT_LLM=20
MCP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── Executor and telemetry ───────────────────────────────────────────────────
# The control plane never runs a shell. Configure the separate executor only when available.
MCP_EXECUTOR_ENABLED=false
MCP_EXECUTOR_URL=
MCP_EXECUTOR_TOKEN=
MCP_EXECUTOR_LOCAL_ENABLED=false
MCP_EXECUTOR_LOCAL_ALLOWED_TARGETS=
MCP_EXECUTOR_POWERSHELL_PATH=pwsh
MCP_TELEMETRY_AUTO_CREATE_INCIDENTS=true
