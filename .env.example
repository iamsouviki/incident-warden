# Copy to .env for Docker Compose. The quick stack works with these defaults.
POSTGRES_DB=mcp_db
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme

# The password the admin account is held at, and the one new accounts are issued. Leave it
# blank and the backend generates a different password on every boot and logs it once at
# WARN — fine for a throwaway container, useless for anything you want to log back into.
MCP_DEFAULT_PASSWORD=

# Optional LLM provider settings. Ollama is the default provider in application.yml.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=phi3:mini
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional third-party incident intake connectors.
MCP_SERVICENOW_ENABLED=false
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
MCP_FRESHSERVICE_ENABLED=false
FRESHSERVICE_DOMAIN=
FRESHSERVICE_API_KEY=

# Autonomous remediation. Keep SIMULATED until a reviewed device executor is available.
MCP_AUTONOMY_ENABLED=false
MCP_AUTONOMY_EXECUTION_MODE=SIMULATED
MCP_AUTONOMY_EXECUTOR_URL=
MCP_AUTONOMY_POLL_INTERVAL_MS=10000
MCP_AUTONOMY_BATCH_SIZE=10
MCP_AUTONOMY_ALLOW_P1=false
MCP_AUTONOMY_MAX_RETRIES=2
MCP_TELEMETRY_AUTO_CREATE_INCIDENTS=true
