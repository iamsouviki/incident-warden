{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "mvn",
      "runtimeArgs": [
        "-o",
        "spring-boot:run",
        "-Dspring-boot.run.profiles=local",
        "-Dmaven.test.skip=true",
        "-Dspring-boot.run.jvmArguments=-Dmcp.autonomy.execution-enabled=true -Dmcp.autonomy.executor-url=http://localhost:9099"
      ],
      "port": 8080
    },
    {
      "name": "executor",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-executor.mjs", "store-0042-pos-01,store-0042-app-01,store-0099-pos-01"],
      "port": 9099
    },
    {
      "name": "smtp",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-smtp.mjs"],
      "port": 1025
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    }
  ]
}
